# Test environment overrides.
# Vitest loads this file before test workers start, so these values take
# precedence over backend/.env. This prevents the production DB_SSL_CA_PATH
# from being used when running the local test suite.
NODE_ENV=test
DB_SSL=false
DB_SSL_CA_PATH=
DB_SSL_VERIFY=false

# Set locally; never commit a real database URL or password.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/agroconnect_test?sslmode=require
TEST_DB_SSL=true
TEST_DB_SSL_VERIFY=false
