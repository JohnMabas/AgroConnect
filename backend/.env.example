NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────────────────────────
# Aiven PostgreSQL connection (preferred). Copy the URI from the Aiven console.
# Never commit real credentials.
DATABASE_URL=

# Aiven requires TLS. Set DB_SSL=true when connecting to Aiven.
# For production certificate verification, provide the Aiven CA certificate path.
# On Render, upload the CA as a Secret File and point DB_SSL_CA_PATH to it,
# for example /etc/secrets/aiven-ca.pem.
DB_SSL=true
DB_SSL_CA_PATH=
# DB_SSL_VERIFY defaults to true. Do not set it to false in production unless
# you explicitly accept encryption without server certificate verification.
DB_SSL_VERIFY=true

# Individual connection variables are only used when DATABASE_URL is empty.
# Intended for local development against a local PostgreSQL server.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Application ─────────────────────────────────────────────────────────────
# Default country used to normalize local phone numbers to E.164.
DEFAULT_PHONE_COUNTRY=NG

FRONTEND_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ─────────────────────────────────────────────────────────────────────
# How long (in seconds) a phone OTP remains valid. Default: 300 (5 minutes).
OTP_EXPIRES_IN_SECONDS=300
# Minimum seconds between OTP resend requests. Default: 60.
OTP_RESEND_COOLDOWN_SECONDS=60
# Maximum failed verification attempts before the OTP is locked. Default: 5.
OTP_MAX_ATTEMPTS=5

# ─── Email verification ───────────────────────────────────────────────────────
# How long (in seconds) an email verification token is valid. Default: 86400 (24 h).
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=86400

# ─── Notification providers ───────────────────────────────────────────────────
# Provider credentials and full setup notes are in the COMMUNICATION PROVIDERS
# section below. Valid values are dev/africastalking for SMS and dev/brevo for
# email. The dev adapters are development-only and are rejected in production.
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev

# ─── Tests ────────────────────────────────────────────────────────────────────
# Isolated database used only by automated tests. The database name must
# include "test" because the suite resets the public schema.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/agroconnect_test
# TEST_DB_SSL=false
# TEST_DB_SSL_VERIFY=false
# TEST_DB_SSL_CA_PATH=

# ==========================================
# AGROCONNECT COMMUNICATION PROVIDERS
# ==========================================

# ─── Email provider: Brevo ───────────────────────────────────────────────────
# Set EMAIL_PROVIDER=brevo to use Brevo (https://brevo.com) for transactional email.
# Obtain your API key at: https://app.brevo.com/settings/keys/api
# BREVO_SENDER_EMAIL must be a verified sender address in your Brevo account.
# Keep EMAIL_PROVIDER=dev for local development, or set it to brevo below.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@yourdomain.com
BREVO_SENDER_NAME=AgroConnect

# ─── SMS provider: Africa's Talking ─────────────────────────────────────────
# Set SMS_PROVIDER=africastalking to use Africa's Talking for SMS delivery.
# Sign up at: https://africastalking.com/
# AFRICASTALKING_USERNAME: use "sandbox" for testing, or your live username.
# AFRICASTALKING_SENDER_ID: registered alphanumeric sender ID, or leave empty
# for the shared shortcode (required in sandbox mode).
# Keep SMS_PROVIDER=dev for local development, or set it to africastalking below.
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_SENDER_ID=your_sender_id_or_leave_empty

# ==========================================
# VERIFICATION SETTINGS
# ==========================================
# OTP length (digits). Default: 6.
OTP_LENGTH=6
# OTP validity in minutes. Maps to OTP_EXPIRES_IN_SECONDS (300 = 5 min).
OTP_EXPIRY_MINUTES=5
# Email verification token validity in minutes (default: 15 min for this config,
# but OTP_EXPIRES_IN_SECONDS=300 and EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=86400
# remain the authoritative settings used by the application).
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# Local development image storage (production should use object storage).
UPLOAD_STORAGE_PATH=uploads
UPLOAD_PUBLIC_PREFIX=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_IMAGES_PER_LISTING=5

# ==========================================
# PHASE 9 — ORDERS & PAYSTACK PAYMENTS
# ==========================================

# ─── Inventory reservations ──────────────────────────────────────────────────
# Minutes an unpaid order keeps inventory reserved. Default: 30.
ORDER_RESERVATION_MINUTES=30
# Interval for the in-process reservation expiry sweep. Default: 60.
ORDER_RESERVATION_SWEEP_INTERVAL_SECONDS=60

# ─── Paystack ────────────────────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developers.
# Never expose the secret key to the frontend or commit a real value.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack API base URL. Default: https://api.paystack.co.
PAYSTACK_BASE_URL=https://api.paystack.co
# URL the buyer returns to after hosted checkout.
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
# Timestamped webhook signing secret (whsec_...) from the Paystack dashboard.
PAYSTACK_WEBHOOK_SIGNING_SECRET=
# Default checkout currency: NGN, GHS, ZAR or USD.
PAYSTACK_CURRENCY=NGN
# test or live. Defaults to live when NODE_ENV=production, otherwise test.
PAYSTACK_MODE=test
# Paystack request timeout in milliseconds. Default: 15000.
PAYSTACK_REQUEST_TIMEOUT_MS=15000

# ==========================================
# PHASE 11 — NOTIFICATIONS
# ==========================================

# In-app notifications are persisted immediately and are not retried.
# Email/SMS deliveries use the providers configured above.
# Maximum delivery attempts before a channel delivery is permanently failed.
NOTIFICATION_MAX_RETRIES=5
# Base delay in seconds for exponential backoff. Attempt N waits
# NOTIFICATION_RETRY_INTERVAL_SECONDS * 2^(N-1), capped at 24 hours.
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
# Interval for the in-process retry and reservation-warning worker.
NOTIFICATION_WORKER_INTERVAL_SECONDS=30
# How long before reservation expiry the buyer receives a warning.
NOTIFICATION_RESERVATION_WARNING_MINUTES=10
# Hard timeout for an individual email or SMS provider call.
NOTIFICATION_PROVIDER_TIMEOUT_SECONDS=15

# ==========================================
# PHASE 12 — REVIEWS, MODERATION & VERIFICATION
# ==========================================

# How long a reviewer may edit their own review after creation (minutes).
REVIEW_EDIT_WINDOW_MINUTES=1440
# Maximum review title and comment lengths.
REVIEW_TITLE_MAX_LENGTH=120
REVIEW_COMMENT_MAX_LENGTH=2000
# Maximum review-report / moderation description length.
REPORT_DESCRIPTION_MAX_LENGTH=1000

# Private root for verification documents. NEVER serve this directory publicly.
VERIFICATION_DOCUMENT_STORAGE_PATH=private-uploads
# Maximum verification document size (10 MiB).
VERIFICATION_DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
# Pending verification requests expire after this many days.
VERIFICATION_REQUEST_EXPIRY_DAYS=30

# ==========================================
# PHASE 13 — MARKET INTELLIGENCE & ANALYTICS
# ==========================================

# Default ISO currency for market price queries and observations. Default: NGN.
MARKET_DEFAULT_CURRENCY=NGN
# Default lookback window (days) for market price and analytics queries. Default: 90.
MARKET_ANALYTICS_DEFAULT_WINDOW_DAYS=90
# Reject observations dated more than this many days in the past. Default: 365.
MARKET_OBSERVATION_MAX_AGE_DAYS=365

# Minimum percentage price movement required for a price insight. Default: 10.
MARKET_INSIGHT_PRICE_CHANGE_THRESHOLD_PERCENT=10
# Minimum supply/demand gap percentage required for shortage/surplus insights. Default: 25.
MARKET_INSIGHT_SUPPLY_DEMAND_GAP_PERCENT=25
# Minimum observation count before price insights are generated. Default: 3.
MARKET_INSIGHT_MIN_OBSERVATIONS=3
# Default lookback window (days) when generating insights. Default: 30.
MARKET_INSIGHT_LOOKBACK_DAYS=30
# Active insights expire after this many days. Default: 30.
MARKET_INSIGHT_EXPIRY_DAYS=30

# ==========================================
# PHASE 14 — AI ASSISTANT, RECOMMENDATIONS & INTEGRITY
# ==========================================
# Use dev without credentials for deterministic, safe rule-based fallbacks.
# For a compatible hosted provider, set AI_PROVIDER=openai_compatible and
# keep AI_API_KEY on the backend only. Never use NEXT_PUBLIC_ for this key.
AI_PROVIDER=dev
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_INPUT_LENGTH=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_RATE_LIMIT_PER_MINUTE=30
AI_DAILY_USER_LIMIT=100
AI_ASSISTANT_ENABLED=true
AI_RECOMMENDATIONS_ENABLED=true
AI_INTEGRITY_ENABLED=true
AI_KNOWLEDGE_SEARCH_LIMIT=5
AI_CONVERSATION_CONTEXT_LIMIT=10
