NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────────────────────────
# Aiven PostgreSQL connection (preferred). Copy the URI from the Aiven console.
# Never commit real credentials.
DATABASE_URL=

# Aiven requires TLS. Set DB_SSL=true when connecting to Aiven.
# For production certificate verification, provide the Aiven CA certificate path.
# On Render, upload the CA as a Secret File and point DB_SSL_CA_PATH to it,
# for example /etc/secrets/aiven-ca.pem.
DB_SSL=true
DB_SSL_CA_PATH=
# DB_SSL_VERIFY defaults to true. Do not set it to false in production unless
# you explicitly accept encryption without server certificate verification.
DB_SSL_VERIFY=true

# Individual connection variables are only used when DATABASE_URL is empty.
# Intended for local development against a local PostgreSQL server.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Application ─────────────────────────────────────────────────────────────
# Default country used to normalize local phone numbers to E.164.
DEFAULT_PHONE_COUNTRY=NG

FRONTEND_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong random secrets for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ─────────────────────────────────────────────────────────────────────
# How long (in seconds) a phone OTP remains valid. Default: 300 (5 minutes).
OTP_EXPIRES_IN_SECONDS=300
# Minimum seconds between OTP resend requests. Default: 60.
OTP_RESEND_COOLDOWN_SECONDS=60
# Maximum failed verification attempts before the OTP is locked. Default: 5.
OTP_MAX_ATTEMPTS=5

# ─── Email verification ───────────────────────────────────────────────────────
# How long (in seconds) an email verification token is valid. Default: 86400 (24 h).
EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=86400

# ─── SMS provider ─────────────────────────────────────────────────────────────
# Set SMS_PROVIDER=dev to log OTPs to the console (development only).
# Set SMS_PROVIDER=africas-talking and supply the credentials for real SMS.
SMS_PROVIDER=dev
SMS_API_KEY=
SMS_SENDER_ID=AgroConnect

# ─── Email provider ───────────────────────────────────────────────────────────
# Set EMAIL_PROVIDER=dev to log emails to the console (development only).
# Set EMAIL_PROVIDER=smtp and supply the credentials for real email delivery.
EMAIL_PROVIDER=dev
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@agroconnect.app

# ─── Tests ────────────────────────────────────────────────────────────────────
# Isolated database used only by automated tests. The database name must
# include "test" because the suite resets the public schema.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/agroconnect_test
# TEST_DB_SSL=false
# TEST_DB_SSL_VERIFY=false
# TEST_DB_SSL_CA_PATH=

# ==========================================
# AGROCONNECT COMMUNICATION PROVIDERS
# ==========================================

# ─── Email provider: Brevo ───────────────────────────────────────────────────
# Set EMAIL_PROVIDER=brevo to use Brevo (https://brevo.com) for transactional email.
# Obtain your API key at: https://app.brevo.com/settings/keys/api
# BREVO_SENDER_EMAIL must be a verified sender address in your Brevo account.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@yourdomain.com
BREVO_SENDER_NAME=AgroConnect

# ─── SMS provider: Africa's Talking ─────────────────────────────────────────
# Set SMS_PROVIDER=africastalking to use Africa's Talking for SMS delivery.
# Sign up at: https://africastalking.com/
# AFRICASTALKING_USERNAME: use "sandbox" for testing, or your live username.
# AFRICASTALKING_SENDER_ID: registered alphanumeric sender ID, or leave empty
# for the shared shortcode (required in sandbox mode).
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_SENDER_ID=your_sender_id_or_leave_empty

# ==========================================
# VERIFICATION SETTINGS
# ==========================================
# OTP length (digits). Default: 6.
OTP_LENGTH=6
# OTP validity in minutes. Maps to OTP_EXPIRES_IN_SECONDS (300 = 5 min).
OTP_EXPIRY_MINUTES=5
# Email verification token validity in minutes (default: 15 min for this config,
# but OTP_EXPIRES_IN_SECONDS=300 and EMAIL_VERIFICATION_EXPIRES_IN_SECONDS=86400
# remain the authoritative settings used by the application).
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# Local development image storage (production should use object storage).
UPLOAD_STORAGE_PATH=uploads
UPLOAD_PUBLIC_PREFIX=/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_IMAGES_PER_LISTING=5
